{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "packages/core/src/**/*",
    "packages/client/src/**/*",
    "packages/server/src/**/*",
    "packages/*/tsup.config.ts",
    "packages/*/vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "examples"
  ]
}
